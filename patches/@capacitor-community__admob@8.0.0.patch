+
+    // Glass Puzzle: the page reserves room for the banner at its bottom, but it
+    // cannot see the native view. Computing that room from insets on the web side
+    // kept disagreeing with where the plugin actually put the banner (WebView
+    // versions, immersive mode, SystemBars padding), and the banner sat over the
+    // game. So after every layout we measure the distance from the banner's top
+    // edge to the WebView's bottom edge on screen and hand it to the page as the
+    // CSS variable --ad-native-band (dp = CSS px). No banner on screen - removed.
+    private boolean bandListenerAdded = false;
+    private int lastBandPx = -1;
+
+    private void publishBand() {
+        Activity activity = activitySupplier.get();
+        if (activity == null) return;
+        View web = activity.findViewById(com.getcapacitor.android.R.id.webview);
+        if (!(web instanceof android.webkit.WebView)) return;
+
+        int band = 0;
+        if (
+            mAdViewLayout != null &&
+            mAdView != null &&
+            mAdViewLayout.getParent() != null &&
+            mAdViewLayout.getVisibility() == View.VISIBLE &&
+            mAdView.getHeight() > 0
+        ) {
+            int[] webAt = new int[2];
+            int[] adAt = new int[2];
+            web.getLocationOnScreen(webAt);
+            mAdView.getLocationOnScreen(adAt);
+            band = Math.max(0, webAt[1] + web.getHeight() - adAt[1]);
+        }
+        if (band == lastBandPx) return;
+        lastBandPx = band;
+
+        float density = activity.getResources().getDisplayMetrics().density;
+        String js = band > 0
+            ? "document.documentElement.style.setProperty('--ad-native-band','" + Math.round(band / density) + "px')"
+            : "document.documentElement.style.removeProperty('--ad-native-band')";
+        ((android.webkit.WebView) web).evaluateJavascript(js, null);
+    }
 }
