+    /** Glass Puzzle: show the banner that was added invisible, once. */
+    private void reveal(RelativeLayout layout) {
+        if (layout != null && layout == mAdViewLayout && layout.getParent() != null && layout.getVisibility() == View.INVISIBLE) {
+            layout.setVisibility(View.VISIBLE);
+        }
+    }
+
+    // Glass Puzzle: the page reserves room for the banner at its bottom, but it
+    // cannot see the native view. Computing that room from insets on the web side
+    // kept disagreeing with where the plugin actually put the banner (WebView
+    // versions, immersive mode, SystemBars padding), and the banner sat over the
+    // game. So after every layout we measure the distance from the banner's top
+    // edge to the WebView's bottom edge on screen and hand it to the page as the
+    // CSS variable --ad-native-band (dp = CSS px). No banner on screen - removed.
+    private boolean bandListenerAdded = false;
+    private int lastBandPx = -1;
+
+    private void publishBand() {
+        Activity activity = activitySupplier.get();
+        if (activity == null) return;
+        View web = activity.findViewById(com.getcapacitor.android.R.id.webview);
+        if (!(web instanceof android.webkit.WebView)) return;
+
+        int band = 0;
+        if (
+            mAdViewLayout != null &&
+            mAdView != null &&
+            mAdViewLayout.getParent() != null &&
+            // INVISIBLE counts: the banner waits invisible for this very measurement.
+            mAdViewLayout.getVisibility() != View.GONE
+        ) {
+            // Measured before the ad loads, not after: until then the AdView is
+            // empty and zero-height, the page learned the real room only once the
+            // banner was already drawn over the game, and then jumped. The adaptive
+            // size is known the moment showBanner runs, and the container is
+            // already in its final place (gravity + inset margin), so:
+            // band = WebView bottom - container bottom + banner height.
+            // Not laid out yet - coordinates are zeros and the room would be wrong.
+            // Wait for the global-layout callback instead of publishing nonsense.
+            if (!mAdViewLayout.isLaidOut() || !web.isLaidOut()) return;
+            AdSize size = mAdView.getAdSize();
+            int adHeight = Math.max(mAdView.getHeight(), size != null ? size.getHeightInPixels(activity) : 0);
+            if (adHeight > 0) {
+                int[] webAt = new int[2];
+                int[] layoutAt = new int[2];
+                web.getLocationOnScreen(webAt);
+                mAdViewLayout.getLocationOnScreen(layoutAt);
+                int layoutBottom = layoutAt[1] + mAdViewLayout.getHeight();
+                band = Math.max(0, webAt[1] + web.getHeight() - layoutBottom + Math.max(adHeight, mAdViewLayout.getHeight()));
+            }
+        }
+        if (band == lastBandPx) return;
+        lastBandPx = band;
+        final RelativeLayout layout = mAdViewLayout;
+        final int published = band;
+
+        float density = activity.getResources().getDisplayMetrics().density;
+        String js = band > 0
+            ? "document.documentElement.style.setProperty('--ad-native-band','" + Math.round(band / density) + "px')"
+            : "document.documentElement.style.removeProperty('--ad-native-band')";
+        // Reveal only after the page has applied the room: the callback comes once
+        // the script has run, and two frames later the page has re-laid out.
+        ((android.webkit.WebView) web).evaluateJavascript(js, (ignored) -> {
+            if (layout != null && published > 0) layout.postDelayed(() -> reveal(layout), 120);
+        });
+    }
